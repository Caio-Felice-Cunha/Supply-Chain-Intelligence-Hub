{
  "name": "Supply Chain Intelligence Hub",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [3307, 8889],
  "portsAttributes": {
    "3307": { "label": "MySQL demo", "onAutoForward": "silent" },
    "8889": { "label": "Jupyter Lab", "onAutoForward": "notify" }
  },
  "postCreateCommand": "python -m pip install -r requirements-dev.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    }
  }
}
