# Copy this file to .env and adjust values for your environment.
# .env is gitignored. The values below are the local Docker Compose demo
# defaults. They are NOT production secrets.

# Database connection used by scripts/etl (read by ETLConfig).
DB_HOST=mysql
DB_PORT=3306
DB_USER=analytics_user
DB_PASSWORD=local-demo-only
DB_NAME=supply_chain_db

# Values consumed by docker-compose.yml for the MySQL container.
MYSQL_ROOT_PASSWORD=local-root-only
MYSQL_DATABASE=supply_chain_db
MYSQL_USER=analytics_user
MYSQL_PASSWORD=local-demo-only
